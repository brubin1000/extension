{
  "manifest_version": 3,
  "name": "ATMS",
  "version": "1.0.1",
  "description": "Artist Tour Management System - AI-powered email to calendar event creation",
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://mail.google.com/*",
    "https://*.mongodb.com/*",
    "https://*.mongodb-realm.com/*",
    "http://localhost:3000/*",
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content/gmail-inject.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "oauth2": {
    "client_id": "245581280666-rm1knoaq72dojulk7sb1gb70s5f2fadb.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.readonly",
      "openid",
      "email",
      "profile"
    ]
  },
  "action": {
    "default_title": "ATMS"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}